{
  "name": "celestial",
  "version": "1.0.0",
  "description": "Celestial is an multi-tooled website, successor to jordan's math work.",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,vite \"bun --watch dev.ts\" \"vite --host 0.0.0.0\"",
    "dev:server": "bun --watch dev.ts",
    "build": "tsc --noEmit && vite build",
    "build:byod": "bun run build",
    "start": "bun index.ts",
    "start:byod": "bun index.ts",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@mercuryworkshop/bare-mux": "^2.1.8",
    "@mercuryworkshop/epoxy-transport": "^2.1.28",
    "@mercuryworkshop/libcurl-transport": "^1.5.2",
    "@mercuryworkshop/scramjet": "^1.1.0",
    "@mercuryworkshop/wisp-js": "^0.4.0",
    "sanitize-html": "^2.17.0",
    "socks-proxy-agent": "^10.0.0",
    "youtube-dl-exec": "^3.1.7",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/sanitize-html": "^2.13.0",
    "@types/yt-search": "^2.10.3",
    "bun-types": "^1.1.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.6.0",
    "vite": "^7.3.1"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
